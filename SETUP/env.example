# Trang thai hien tai cua lab (script set_mode.sh ghi de cac dong nay)
MODE=vulnerable            # vulnerable | secure  (TEN BIEN DUNG THEO CODE THAT CUA TV1/TV2: "MODE", khong phai APP_MODE)
WAF_ENGINE=Off             # Off | DetectionOnly | On
CSP_ENABLED=0              # 0 | 1  (CSP tang proxy; CSP tang app do TV2 cau hinh rieng, khong doi o day)
PARANOIA=1                 # 1-4 (CRS paranoia level)

DB_NAME=shop_db
DB_USER=app_user
DB_PASS=AppPass123!
DB_ROOT_PASS=rootpass
PUBLIC_PORT=8080           # Cong duy nhat vao app, qua proxy+WAF
CATCHER_PORT=8888          # Cong cookie-stealer. GIU NGUYEN 8888: cac payload cua TV2
                            # (xss_payloads.txt, payload_xss.json) da hardcode http://localhost:8888
